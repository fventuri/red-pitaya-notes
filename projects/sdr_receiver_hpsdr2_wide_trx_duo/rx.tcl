  COEFFICIENT_WIDTH 24
  QUANTIZATION Quantize_Only
  BESTPRECISION true
  FILTER_TYPE Decimation
  RATE_CHANGE_TYPE Fixed_Fractional
  INTERPOLATION_RATE 4
  DECIMATION_RATE 5
  NUMBER_CHANNELS 12
  NUMBER_PATHS 1
  SAMPLE_FREQUENCY 0.96
  CLOCK_FREQUENCY 125
  OUTPUT_ROUNDING_MODE Convergent_Rounding_to_Even
  OUTPUT_WIDTH 26
  HAS_ARESETN true
} {
  S_AXIS_DATA subset_0/M_AXIS
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# Constant +17.1 dB gain with 24-bit saturation. The 4/5 chain runs a constant
# ~17 dB low (FIR1 BESTPRECISION reserves headroom for its ~+11 dB CIC-droop passband
# boost, plus ~6 dB from interp-4 polyphase scaling). Restore unity passband level
# here in the DSP chain (7332/1024 = 7.160x). Combinational, no added latency.
cell axis_gain gain_0 {
  AXIS_TDATA_WIDTH 32
  DATA_WIDTH 24
  GAIN_NUM 7332
  GAIN_SHIFT 10
} {
  S_AXIS fir_1/M_AXIS_DATA
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# Create axis_dwidth_converter
cell xilinx.com:ip:axis_dwidth_converter conv_1 {
  S_TDATA_NUM_BYTES.VALUE_SRC USER
  S_TDATA_NUM_BYTES 4
  M_TDATA_NUM_BYTES 48
} {
  S_AXIS gain_0/M_AXIS
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# DMA the frame words into a DDR ring over the cache-coherent ACP port,
# replacing the CPU-polled FIFO read window.
# conv_1/M_AXIS emits one 48-byte instant =
#   [DDC0_I, DDC0_Q, DDC1_I, DDC1_Q, ... DDC5_I, DDC5_Q], each 4 bytes LE, 26-bit signed.
# The xpm_fifo inside axis_ram_writer only supports power-of-2 width ratios, so we
# serialize the 384-bit instant down to the 64-bit ACP width (ratio 1) with conv_2
# instead of feeding 384-bit (ratio 6, illegal). In DDR each instant lands as six
# contiguous 64-bit beats = 48 bytes: bytes[d*8 .. d*8+3] = DDC d I,
# bytes[d*8+4 .. d*8+7] = DDC d Q. The 24-bit narrow + HPSDR big-endian reorder that
# subset_1 used to do now happens in the server's build_packet.
#
# min_addr : physical base of the CMA ring buffer   (cfg bits 255:224, set by server)
# cfg_data : ring size minus one, in 128-byte bursts (cfg bits 287:256, set by server).
#            e.g. 24575 -> 24576 * 128 B = 3 MiB = 768 pages, a whole multiple of the
#            48-byte frame (LCM(128,48)=384) and of 4 KiB, so the ring wraps on a
#            frame boundary (no straddling frames).
# sts_data : write pointer in 128-byte units (server polls it via hub sts).

# Create axis_dwidth_converter
cell xilinx.com:ip:axis_dwidth_converter conv_2 {
  S_TDATA_NUM_BYTES.VALUE_SRC USER
  S_TDATA_NUM_BYTES 48
  M_TDATA_NUM_BYTES 8
} {
  S_AXIS conv_1/M_AXIS
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# Create port_slicer
cell port_slicer slice_min_addr {
  DIN_WIDTH 288 DIN_FROM 255 DIN_TO 224
} {
  din hub_0/cfg_data
}

# Create port_slicer
cell port_slicer slice_ring {
  DIN_WIDTH 288 DIN_FROM 287 DIN_TO 256
} {
  din hub_0/cfg_data
}

# Create axis_ram_writer
cell axis_ram_writer writer_0 {
  ADDR_WIDTH 32
  AXI_ID_WIDTH 3
  AXIS_TDATA_WIDTH 64
  FIFO_WRITE_DEPTH 512
} {
  S_AXIS conv_2/M_AXIS
  min_addr slice_min_addr/dout
  cfg_data slice_ring/dout
  sts_data hub_0/sts_data
  aclk /pll_0/clk_out1
  aresetn slice_0/dout
}
