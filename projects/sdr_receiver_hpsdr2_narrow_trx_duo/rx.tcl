  COEFFICIENT_WIDTH 24
  QUANTIZATION Quantize_Only
  BESTPRECISION true
  FILTER_TYPE Decimation
  RATE_CHANGE_TYPE Fixed_Fractional
  INTERPOLATION_RATE 2
  DECIMATION_RATE 5
  NUMBER_CHANNELS $n_ch
  NUMBER_PATHS 1
  SAMPLE_FREQUENCY 0.48
  CLOCK_FREQUENCY 250
  OUTPUT_ROUNDING_MODE Convergent_Rounding_to_Even
  OUTPUT_WIDTH 26
  HAS_ARESETN true
} {
  S_AXIS_DATA subset_0/M_AXIS
  aclk /pll_0/clk_out2
  aresetn /rst_1/peripheral_aresetn
}

# ---- cross the low-rate (48 ksps/ch) FIR output from the 250 MHz DSP domain back
#      to the 125 MHz ACP/writer domain. Placed at the lowest data rate in the chain
#      so the async FIFO is tiny.
cell xilinx.com:ip:axis_clock_converter cc_0 {
  TDATA_NUM_BYTES.VALUE_SRC USER
  TDATA_NUM_BYTES 4
  IS_ACLK_ASYNC 1
} {
  S_AXIS fir_1/M_AXIS_DATA
  s_axis_aclk /pll_0/clk_out2
  s_axis_aresetn /rst_1/peripheral_aresetn
  m_axis_aclk /pll_0/clk_out1
  m_axis_aresetn /rst_0/peripheral_aresetn
}

# pack two consecutive 4-byte channel samples (one DDC's I,Q) into one 8-byte word =
# the 64-bit ACP data beat. Feeding the writer at the AXI data width (64) keeps its
# FIFO to a single block-RAM tile instead of being width-bound at ~16 by a 1024-bit
# frame word. The DDR byte layout is unchanged: 16 such words = one 128-byte instant.
cell xilinx.com:ip:axis_dwidth_converter conv_1 {
  S_TDATA_NUM_BYTES.VALUE_SRC USER
  S_TDATA_NUM_BYTES 4
  M_TDATA_NUM_BYTES 8
} {
  S_AXIS cc_0/M_AXIS
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# ---- DMA the frame words into the DDR ring over the cache-coherent ACP port ----
# conv_1/M_AXIS emits one 8-byte (64-bit) word per DDC = [DDC_d I, DDC_d Q], each
# 4 bytes LE, 26-bit signed. n_ddc such words land contiguously per instant, so in
# DDR one instant is still n_ddc*8 bytes: [DDC0_I, DDC0_Q, DDC1_I, DDC1_Q, ...].
# The server's build_packet does the 24-bit + HPSDR big-endian reorder.
# The server's build_packet does the 24-bit + HPSDR big-endian reorder.
# Power-of-2 n_ddc (8,16,32) keeps the frame a whole multiple of 64 bit; other N
# would need a width gearbox like the wide project (not needed at 8/16).

cell port_slicer slice_min_addr {
  DIN_WIDTH $cfg_width DIN_FROM [expr {$off_min * 8 + 31}] DIN_TO [expr {$off_min * 8}]
} {
  din hub_0/cfg_data
}

cell port_slicer slice_ring {
  DIN_WIDTH $cfg_width DIN_FROM [expr {$off_ring * 8 + 31}] DIN_TO [expr {$off_ring * 8}]
} {
  din hub_0/cfg_data
}

# GPIO open-collector register -> E1 expansion P-side pins (BCD/filter control)
cell port_slicer gpio_slice {
  DIN_WIDTH $cfg_width DIN_FROM [expr {$off_gpio * 8 + 7}] DIN_TO [expr {$off_gpio * 8}]
} {
  din hub_0/cfg_data
}

# 64-bit AXIS in = the AXI data width, so the FIFO is symmetric and fits one BRAM
# tile (a 1024-bit frame word would make it width-bound at ~16 RAMB36). BRAM is the
# binding resource at n_ddc=16.
cell axis_ram_writer writer_0 {
  ADDR_WIDTH 32
  AXI_ID_WIDTH 3
  AXIS_TDATA_WIDTH 64
  FIFO_WRITE_DEPTH 512
} {
  S_AXIS conv_1/M_AXIS
  min_addr slice_min_addr/dout
  cfg_data slice_ring/dout
  sts_data hub_0/sts_data
  aclk /pll_0/clk_out1
  aresetn slice_0/dout
}
