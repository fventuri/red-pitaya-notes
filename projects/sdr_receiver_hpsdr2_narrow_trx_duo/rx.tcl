# sdr_receiver_hpsdr2_narrow_trx_duo - Protocol-2 receiver, 48 ksps only, N DDCs.
#
# Derived from sdr_receiver_hpsdr2_trx_duo. Differences:
#   * dds_phase (0-DSP phase-truncation NCO) replaces dds (3 DSP each) - frees the
#     DSP that capped the DDC count. SFDR ~66 dBc (11-bit truncation).
#   * fixed 48-ksps decimation: CIC /1000 (Fixed, not Programmable) then fir_0 x24/25
#     then fir_1 x2/5. The programmable-rate axis_variable machinery is gone.
#   * the DDC count is a single knob, n_ddc, so the "add channels -> synth -> read
#     utilization -> stop when it binds" loop of PLAN_NARROW_48_MAXDDC is one edit.
#   * cfg register map is laid out from n_ddc (freq array grows), see below.
#
# cfg byte map (LSB bit numbering), all little-endian, written by the server:
#   b0        bit0 : writer/stream reset (active low via slice_0)
#   b4..      freq[0..n_ddc-1], 32-bit phase increment each
#   S+0       sel  : per-DDC ADC-select bitmap (bit d = DDC d uses ADC1)
#   S+4       min_addr : CMA ring physical base (writer)
#   S+8       ring     : ring size-1 in 128-byte bursts (writer)
#   S+12      gpio     : open-collector outputs -> E1 exp_p pins (byte)
# where S = 4 + 4*n_ddc.

set n_ddc 16
set n_ch  [expr {2 * $n_ddc}]

# ---- cfg register layout derived from n_ddc ----
set off_freq 4
set off_tail [expr {4 + 4 * $n_ddc}]
set off_sel  $off_tail
set off_min  [expr {$off_tail + 4}]
set off_ring [expr {$off_tail + 8}]
set off_gpio [expr {$off_tail + 12}]
set cfg_bytes [expr {$off_gpio + 1}]
set cfg_width [expr {32 * (($cfg_bytes * 8 + 31) / 32)}]

# Create axi_hub
cell axi_hub hub_0 {
  CFG_DATA_WIDTH $cfg_width
  STS_DATA_WIDTH 32
} {
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# writer reset: cfg bit 0
cell port_slicer slice_0 {
  DIN_WIDTH $cfg_width DIN_FROM 0 DIN_TO 0
} {
  din hub_0/cfg_data
}

for {set i 0} {$i < $n_ddc} {incr i} {

  # per-DDC ADC select bit
  cell port_slicer sel_slice_$i {
    DIN_WIDTH $cfg_width DIN_FROM [expr {$off_sel * 8 + $i}] DIN_TO [expr {$off_sel * 8 + $i}]
  } {
    din hub_0/cfg_data
  }

  cell port_selector selector_$i {
    DOUT_WIDTH 16
  } {
    cfg sel_slice_$i/dout
    din /adc_0/m_axis_tdata
  }

  # per-DDC phase increment
  cell port_slicer freq_slice_$i {
    DIN_WIDTH $cfg_width \
      DIN_FROM [expr {$off_freq * 8 + 32 * $i + 31}] \
      DIN_TO   [expr {$off_freq * 8 + 32 * $i}]
  } {
    din hub_0/cfg_data
  }

  # 0-DSP phase-truncation NCO.
  # DITHER FALSE for v0.6.4: phase dithering (dds_phase DITHER=TRUE) is functionally
  # correct (xsim: cos/sin bit-balanced, spurs -> noise) but its extra logic x16 congested
  # placement and pushed the clk_out1->clk_out2 NCO->mixer handoff from +102 ps to +5 ps
  # WNS, which corrupted the odd-cycle (sin/Q) capture on silicon (measured Q std ~4.6x I,
  # image ~-19 dB). Deferred to v0.6.5 pending a proper timing fix (multicycle/false-path
  # on the mux-gated cos/sin->A paths, or a compact dither). See REPLY_HENNING + HANDOFF.
  cell dds_phase dds_$i {
    NEGATIVE_SINE TRUE
    DITHER FALSE
  } {
    pinc freq_slice_$i/dout
    aclk /pll_0/clk_out1
    aresetn /rst_0/peripheral_aresetn
  }

}

# ---- time-shared complex mixer bank (cores/mixer_ts_bank.v) ------------------
#      Replaces the 2*n_ddc parallel dsp48 mixers + the product xlconcat. One DSP per
#      DDC computes BOTH products (I=cos*adc even cycle, Q=sin*adc odd cycle) using the
#      2 cycles/125 MHz-sample the 250 MHz clock gives -> mixer DSP 2/DDC -> 1/DDC.
#      Its period-stable, all-channels-together output bus also gives the mixer->CIC
#      hand-off its own pipeline cycle (movable fabric flop instead of DSP-out feeding
#      the 64-bit stage-0 add directly) -> lets clk_out2 close. Verified bit-exact vs
#      the parallel bus in xsim (K=4 even -> phase into cic preserved).
#
# gather per-DDC NCO {sin,cos} (dds_$d/dout, 48-bit) and selected ADC (selector_$d/dout,
# 16-bit) into two wide buses, DDC0 in the LSBs (xlconcat In0 -> dout LSBs).
set nco_props "NUM_PORTS $n_ddc"
set adc_props "NUM_PORTS $n_ddc"
for {set d 0} {$d < $n_ddc} {incr d} {
  append nco_props " IN${d}_WIDTH 48"
  append adc_props " IN${d}_WIDTH 16"
}
cell xilinx.com:ip:xlconcat concat_nco $nco_props {}
cell xilinx.com:ip:xlconcat concat_adc $adc_props {}
for {set d 0} {$d < $n_ddc} {incr d} {
  wire concat_nco/In$d dds_$d/dout
  wire concat_adc/In$d selector_$d/dout
}

cell mixer_ts_bank mixer_0 {
  N_DDC $n_ddc
  NCO_W 24
  ADC_W 16
  P_W   24
} {
  nco concat_nco/dout
  adc concat_adc/dout
  aclk /pll_0/clk_out2
  aresetn /rst_1/peripheral_aresetn
}

set comb_bytes [expr {$n_ch * 4}]

# ---- custom time-shared multichannel CIC (cores/cic_ts_bank.v) ---------------
#      Replaces the n_ch parallel cic_compiler instances + the axis_combiner tree +
#      conv_0. Runs in the 250 MHz DSP domain: N_LANE = n_ch/2 full-rate integrator
#      lanes (FF) + one shared sequential comb engine (BRAM prev-state). It consumes
#      the mixer products directly and emits a channel-interleaved 4-byte AXIS stream
#      (ch0..ch{n_ch-1}), byte-for-byte what conv_0/M_AXIS produced, feeding fir_0.
#      The output bit-slice was pinned bit-exact to cic_compiler in xsim (DC test).

cell cic_ts_bank125 cic_bank_0 {
  N_CH $n_ch
  DIN_W 24
  DOUT_W 32
  STAGES 4
  R 1000
  ACC_W 64
  SLICE_HI 63
} {
  in_data mixer_0/out_data
  aclk /pll_0/clk_out1
  aresetn /rst_0/peripheral_aresetn
}

# The un-folded CIC runs in the 125 MHz (clk_out1) domain; fir_0 is at 250 MHz. Bridge
# the low-rate channel-interleaved stream across the boundary (mirror of cc_0 below).
# IS_ACLK_ASYNC 1: force the ASYNC (gray-code FIFO) converter. When left default, the tool
# propagates a SYNCHRONOUS 1:2 converter (clk_out1/clk_out2 are integer-related from one
# PLL) whose sample-cycle sequencing SCRAMBLES + DUPLICATES this 32-channel TDM stream ->
# the shipped v0.6.3 chipmunk (24 ksps) + mirror. Async is bit-exact identity in xsim
# (perfect [D0I,D0Q,D1I,...] packing); see docs/HANDOFF_NARROW_CDC_ROOTCAUSE.md.
cell xilinx.com:ip:axis_clock_converter cc_in {
  TDATA_NUM_BYTES.VALUE_SRC USER
  TDATA_NUM_BYTES 4
  IS_ACLK_ASYNC 1
} {
  S_AXIS cic_bank_0/M_AXIS
  s_axis_aclk /pll_0/clk_out1
  s_axis_aresetn /rst_0/peripheral_aresetn
  m_axis_aclk /pll_0/clk_out2
  m_axis_aresetn /rst_1/peripheral_aresetn
}

